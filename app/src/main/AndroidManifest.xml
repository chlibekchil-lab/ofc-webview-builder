<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin untuk kunci layar jarak jauh (Device Administrator) -->
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- Izin untuk melihat lokasi (hanya diminta jika toggle lokasi dinyalakan) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Catatan: izin PACKAGE_USAGE_STATS bersifat "special app access" —
         tidak dideklarasikan biasa, harus diarahkan lewat Settings.ACTION_USAGE_ACCESS_SETTINGS
         (lihat PermissionScreens.kt) -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".GuardlineApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Guardline Companion"
        android:theme="@style/Theme.GuardlineCompanion">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Penerima Device Admin: inilah yang memberi izin apk melakukan lockNow() -->
        <receiver
            android:name=".GuardlineDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".GuardlineForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <service
            android:name=".GuardlineAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
